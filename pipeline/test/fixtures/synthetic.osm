  <node id="212" version="1" lat="41.715" lon="44.745"/>
  <node id="213" version="1" lat="41.715" lon="44.751"/>
  <node id="301" version="1" lat="41.705" lon="44.705"/>
  <node id="302" version="1" lat="41.705" lon="44.710"/>
  <node id="303" version="1" lat="41.708" lon="44.710"/>
  <node id="304" version="1" lat="41.708" lon="44.705"/>
  <node id="401" version="1" lat="41.735" lon="44.725">
    <tag k="place" v="neighbourhood"/>
    <tag k="name" v="Test Place"/>
  </node>

  <way id="101" version="1">
    <nd ref="1"/><nd ref="5"/><nd ref="2"/><nd ref="3"/><nd ref="6"/><nd ref="4"/><nd ref="1"/>
  </way>
  <way id="111" version="1">
