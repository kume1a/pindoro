    "/v1/league/me": {
      "put": {
        "tags": [
          "leagues"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "week",
                  "xp"
                ],
                "properties": {
                  "week": {
                    "type": "string",
                    "format": "date"
                  },
                  "xp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "player",
                    "league"
                  ],
                  "properties": {
                    "player": {
                      "type": "object",
                      "required": [
                        "id",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "league": {
                      "type": "object",
                      "required": [
                        "tier",
                        "week",
                        "ends_at",
                        "members"
                      ],
                      "properties": {
                        "tier": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "week": {
                          "type": "string",
                          "format": "date"
                        },
                        "ends_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "members": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "rank",
                              "name",
                              "xp",
                              "zone",
                              "you"
                            ],
                            "properties": {
                              "rank": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "name": {
                                "type": "string"
                              },
                              "xp": {
                                "type": "integer"
                              },
                              "zone": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "up"
                                    ]
                                  },
                                  {
                                    "type": "string",
                                    "enum": [
                                      "stay"
                                    ]
                                  },
                                  {
                                    "type": "string",
                                    "enum": [
                                      "down"
                                    ]
                                  }
                                ]
                              },
                              "you": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
