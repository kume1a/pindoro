{
  "openapi": "3.0.3",
  "info": {
    "title": "Pindoro API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "unavailable"
                          ]
                        }
                      ]
                    },
                    "postgis": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "unavailable"
                          ]
                        }
                      ]
                    },
                    "postgis": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cities"
                  ],
                  "properties": {
                    "cities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name_ka",
                          "name_en",
                          "pack"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name_ka": {
                            "type": "string"
                          },
                          "name_en": {
                            "type": "string"
                          },
                          "pack": {
                            "type": "object",
                            "required": [
                              "format_version",
                              "version",
                              "url",
                              "sha256",
                              "size",
                              "osm_timestamp"
                            ],
                            "properties": {
                              "format_version": {
                                "type": "integer"
                              },
                              "version": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "sha256": {
                                "type": "string"
                              },
                              "size": {
                                "type": "integer"
                              },
                              "osm_timestamp": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
