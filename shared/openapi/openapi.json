    "/v1/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cities"
                  ],
                  "properties": {
                    "app": {
                      "type": "object",
                      "required": [
                        "build",
                        "url"
                      ],
                      "properties": {
                        "build": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    },
                    "cities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name_ka",
                          "name_en",
                          "pack"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name_ka": {
                            "type": "string"
                          },
                          "name_en": {
                            "type": "string"
                          },
                          "bbox": {
                            "type": "object",
                            "required": [
                              "min_lat",
                              "min_lon",
                              "max_lat",
                              "max_lon"
                            ],
                            "properties": {
                              "min_lat": {
                                "type": "number"
                              },
                              "min_lon": {
                                "type": "number"
                              },
                              "max_lat": {
                                "type": "number"
                              },
                              "max_lon": {
                                "type": "number"
                              }
                            }
                          },
                          "pack": {
                            "type": "object",
                            "required": [
                              "format_version",
                              "version",
                              "url",
                              "sha256",
                              "size",
                              "osm_timestamp"
                            ],
                            "properties": {
                              "format_version": {
                                "type": "integer"
                              },
                              "version": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "sha256": {
                                "type": "string"
                              },
                              "size": {
                                "type": "integer"
                              },
                              "osm_timestamp": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
