# Copy to .env at the repo root. Compose files live in infra/, so relative
# paths below resolve against infra/ (pass --env-file .env, the justfile does).

# Domain managed in Cloudflare; Caddy routes api., tiles. and packs. subdomains.
DOMAIN=pindoro.example.com

POSTGRES_USER=pindoro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pindoro

# Token-based Cloudflare Tunnel (Zero Trust > Networks > Tunnels). Prod only.
CLOUDFLARE_TUNNEL_TOKEN=

# The newest sideload build (the +N of apps/mobile/pubspec.yaml's version) and
# its APK link; older installs offer it at launch (docs/deploy.md § 9).
# APP_BUILD=2
# APP_URL=https://packs.pindoro.example.com/app/pindoro-2.apk

# Host directories mounted into the containers.
PACKS_DIR=./packs
TILES_DIR=./tiles
