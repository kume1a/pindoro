# Production settings. On the server the Deploy workflow writes .env at the repo root from the
# repository's Actions variables (docs/deploy.md § 3). Compose files live in infra/, so relative
# paths below resolve against infra/ (pass --env-file .env, the justfile does).

# Public hostname; the host's Cloudflare Tunnel routes it to Caddy on HTTP_PORT. The API answers at
# its root, tiles under /tiles, packs under /packs.
PUBLIC_HOST=pindoro.example.com
# HTTP_PORT=8100

# Hex only: the password goes into a connection URL.
POSTGRES_USER=pindoro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pindoro

# The newest sideload build (the +N of apps/mobile/pubspec.yaml's version) and
# its APK link; older installs offer it at launch (docs/deploy.md § 9).
# APP_BUILD=2
# APP_URL=https://pindoro.example.com/packs/app/pindoro-2.apk

# Host directories mounted into the containers.
PACKS_DIR=./packs
TILES_DIR=./tiles
