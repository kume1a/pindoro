# TLS ends at Cloudflare; cloudflared forwards plain HTTP to caddy:80 with the original Host.
{
	auto_https off
}

http://api.{$DOMAIN} {
	reverse_proxy api:3000
}

http://tiles.{$DOMAIN} {
	reverse_proxy martin:3000
}

http://packs.{$DOMAIN} {
	root * /srv/packs

	# Versioned pack files never change; the pointers to them do.
	@immutable path *.sqlite.gz
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pointers path /catalog.json */manifest.json
	header @pointers Cache-Control "public, max-age=60"

	file_server
}
