# TLS ends at Cloudflare; the host's tunnel forwards plain HTTP to Caddy. One hostname: the API at
# the root, tiles under /tiles, packs under /packs.
{
	auto_https off
}

:80 {
	handle_path /tiles/* {
		reverse_proxy martin:3000
	}

	handle_path /packs/* {
		root * /srv/packs

		# Versioned pack files never change; the pointers to them do.
		@immutable path *.sqlite.gz
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@pointers path */manifest.json
		header @pointers Cache-Control "public, max-age=60"

		file_server
	}

	handle {
		reverse_proxy api:3000
	}
}
