          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_result\" (\"id\" TEXT NOT NULL, \"city_id\" TEXT NOT NULL, \"unit_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"lesson\" INTEGER NULL, \"difficulty\" TEXT NOT NULL, \"xp\" INTEGER NOT NULL, \"perfect\" INTEGER NOT NULL CHECK (\"perfect\" IN (0, 1)), \"right_first\" INTEGER NOT NULL, \"tests\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"finished_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
