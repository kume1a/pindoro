        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_item\" (\"city_id\" TEXT NOT NULL, \"street_id\" TEXT NOT NULL, \"step\" INTEGER NOT NULL, \"great_run\" INTEGER NOT NULL, \"due_on\" TEXT NOT NULL, \"last_tier\" TEXT NOT NULL, \"last_at\" TEXT NOT NULL, PRIMARY KEY (\"city_id\", \"street_id\"));"
