    {
      "name": "round",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"round\" (\"id\" TEXT NOT NULL, \"city_id\" TEXT NOT NULL, \"area_json\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"pack_version\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, \"retry_of\" TEXT NULL REFERENCES round (id), \"pit_stop\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pit_stop\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "answer",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"answer\" (\"id\" TEXT NOT NULL, \"round_id\" TEXT NOT NULL REFERENCES round (id), \"street_id\" TEXT NOT NULL, \"pin_lat\" REAL NOT NULL, \"pin_lon\" REAL NOT NULL, \"distance_m\" REAL NOT NULL, \"tier\" TEXT NOT NULL, \"xp\" INTEGER NOT NULL, \"pack_version\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "answer_immutable",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER answer_immutable BEFORE UPDATE ON answer BEGIN SELECT RAISE (ABORT, 'answer rows are immutable');END"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"last_city\" TEXT NULL, \"last_area_json\" TEXT NULL, \"last_difficulty\" TEXT NULL, \"app_language\" TEXT NULL, \"street_names\" TEXT NOT NULL DEFAULT 'local', \"theme\" TEXT NOT NULL DEFAULT 'system', \"sound\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sound\" IN (0, 1)), \"haptics\" INTEGER NOT NULL DEFAULT 1 CHECK (\"haptics\" IN (0, 1)), \"home_coach_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"home_coach_seen\" IN (0, 1)), \"daily_goal\" INTEGER NOT NULL DEFAULT 500, \"reminder\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder\" IN (0, 1)), \"turn_list\" INTEGER NOT NULL DEFAULT 0 CHECK (\"turn_list\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "round_question",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"round_question\" (\"round_id\" TEXT NOT NULL REFERENCES round (id), \"position\" INTEGER NOT NULL, \"street_id\" TEXT NOT NULL, PRIMARY KEY (\"round_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "goal_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_day\" (\"date\" TEXT NOT NULL, \"round_id\" TEXT NULL REFERENCES round (id), PRIMARY KEY (\"date\"));"
        }
      ]
    },
