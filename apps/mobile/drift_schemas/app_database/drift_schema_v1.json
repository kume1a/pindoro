      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"round\" (\"id\" TEXT NOT NULL, \"city_id\" TEXT NOT NULL, \"area_json\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"pack_version\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
