          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"last_city\" TEXT NULL, \"last_area_json\" TEXT NULL, \"last_difficulty\" TEXT NULL, \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"));"
