import 'database.dart';

-- The drive log is append-only (docs/learning/SPEC.md §16.23 item 124); only drive_track rows go.
CREATE TRIGGER drive_no_update BEFORE UPDATE ON drive
BEGIN
  SELECT RAISE(ABORT, 'drive rows are immutable');
END;

CREATE TRIGGER drive_no_delete BEFORE DELETE ON drive
BEGIN
  SELECT RAISE(ABORT, 'drive rows are never deleted');
END;

CREATE TRIGGER drive_decision_no_update BEFORE UPDATE ON drive_decision
BEGIN
  SELECT RAISE(ABORT, 'drive decisions are immutable');
END;

CREATE TRIGGER drive_decision_no_delete BEFORE DELETE ON drive_decision
BEGIN
  SELECT RAISE(ABORT, 'drive decisions are never deleted');
END;

CREATE TRIGGER drive_event_no_update BEFORE UPDATE ON drive_event
BEGIN
  SELECT RAISE(ABORT, 'drive events are immutable');
END;

CREATE TRIGGER drive_event_no_delete BEFORE DELETE ON drive_event
BEGIN
  SELECT RAISE(ABORT, 'drive events are never deleted');
END;
